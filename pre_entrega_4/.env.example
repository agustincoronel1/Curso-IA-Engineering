# Pre-entrega 4 - variables de entorno necesarias.
# Copia estas lineas al archivo .env de la RAIZ del repositorio (el mismo
# .env que ya usan pre_entrega_1 y pre_entrega_3) y completa los valores
# reales. NUNCA subas el .env real a Git.

# API Key de OpenAI (se usa para generar los embeddings text-embedding-3-small).
OPENAI_API_KEY=your_openai_api_key

# API Key de Pinecone (Settings -> API Keys en app.pinecone.io).
PINECONE_API_KEY=your_pinecone_api_key

# Nombre del indice Serverless de Pinecone. Si no existe, setup_pinecone.py lo crea.
INDEX_NAME=preentrega4-rag

# Namespace dentro del indice donde se guardan los chunks de esta entrega.
NAMESPACE=technical-docs

# Modelo de embeddings de OpenAI. text-embedding-3-small produce vectores de
# 1536 dimensiones, que es la dimension con la que se crea el indice.
EMBEDDING_MODEL=text-embedding-3-small
